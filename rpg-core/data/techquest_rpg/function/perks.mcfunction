# No skill experience or numeric levels. Vanilla advancement milestones grant mild temporary perks.
execute as @a[advancements={minecraft:story/iron_tools=true}] run effect give @s minecraft:haste 7 0 true
execute as @a[advancements={minecraft:nether/obtain_blaze_rod=true}] run effect give @s minecraft:resistance 7 0 true
execute as @a[advancements={minecraft:end/kill_dragon=true}] run effect give @s minecraft:speed 7 0 true
