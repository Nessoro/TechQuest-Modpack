{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechQuest Broken Arrow bridge strike order v1",
  "description": "Proposed payload for server-side validation. This is a design artifact, not an implemented or accessible API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "kind",
    "origin",
    "weapon",
    "target",
    "requested_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "const": "airstrike"
    },
    "origin": {
      "type": "string",
      "enum": [
        "minecraft",
        "commander"
      ]
    },
    "weapon": {
      "type": "string",
      "enum": [
        "bunker",
        "missile"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "x",
        "y",
        "z"
      ],
      "properties": {
        "dimension": {
          "type": "string",
          "const": "minecraft:overworld"
        },
        "x": {
          "type": "integer",
          "minimum": -29999984,
          "maximum": 29999984
        },
        "y": {
          "type": "integer",
          "minimum": -64,
          "maximum": 319
        },
        "z": {
          "type": "integer",
          "minimum": -29999984,
          "maximum": 29999984
        }
      }
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
